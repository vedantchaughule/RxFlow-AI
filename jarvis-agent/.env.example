AGENT_REQUEST_TIMEOUT_MS=15000
AGENT_MAX_INPUT_CHARS=4000
AGENT_MAX_TOOL_STEPS=4
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
