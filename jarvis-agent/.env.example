NODE_ENV=development
PORT=5001
JARVIS_PUBLIC_URL=http://localhost:5001
JARVIS_ALLOWED_ORIGINS=http://localhost:5173
RXFLOW_BACKEND_URL=http://localhost:5000
JARVIS_SESSION_JWT_SECRET=<same-at-least-64-character-secret-as-backend>
JARVIS_INTERNAL_HMAC_SECRET=<same-different-at-least-64-character-secret-as-backend>
AI_PROVIDER=none
