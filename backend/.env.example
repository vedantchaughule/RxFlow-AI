NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/rxflow_dev

# JWT secrets must be distinct 64-character random values.
JWT_ACCESS_SECRET=replace_with_a_64_character_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_64_character_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM key (64 hexadecimal characters) for locally stored TOTP secrets.
ENCRYPTION_KEY=replace_with_64_hex_characters

CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_DOMAIN=
AUTH_COOKIE_NAME=rxflow_refresh
PLATFORM_SUPPORT_KEY=replace_with_a_long_random_value

SESSION_IDLE_MINUTES=15
SESSION_MAX_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12
PASSWORD_RESET_TTL_MINUTES=30

# Use capture only for local development. Production startup requires smtp.
EMAIL_ADAPTER=capture
EMAIL_FROM=noreply@example.test

# Emergency global stop for all AI inference. Clinic controls cannot override it.
AI_KILL_SWITCH=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=


# Optional doctor-supervised Jarvis agent.
JARVIS_ENABLED=false
JARVIS_AGENT_URL=http://localhost:5001
JARVIS_SESSION_JWT_SECRET=replace_with_a_new_64_character_random_secret
JARVIS_INTERNAL_HMAC_SECRET=replace_with_a_different_64_character_random_secret
JARVIS_SESSION_TTL_SECONDS=300
JARVIS_INTERNAL_MAX_SKEW_SECONDS=60

# Optional server-side ElevenLabs output. Never expose this key to the frontend.
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_REQUEST_TIMEOUT_MS=10000
